PORT=5000
DB_HOST=localhost
DB_PORT=3306
DB_USER=your_database_user
DB_PASSWORD=your_database_password
DB_NAME=mess_management
DB_SSL=false
JWT_SECRET=replace_with_a_long_random_secret

FRONTEND_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=https://your-frontend-domain
TRUST_PROXY=false
JSON_BODY_LIMIT=32kb
API_RATE_LIMIT_MAX=300
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=14
NODE_ENV=development
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAME_SITE=lax

DB_CONNECTION_LIMIT=10
DB_QUEUE_LIMIT=25
DB_CONNECT_TIMEOUT_MS=10000
DB_MAX_IDLE=10
DB_IDLE_TIMEOUT_MS=60000

GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback

AI_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-2.5-flash

EMAIL_PROVIDER=smtp
EMAIL_FROM="MessMate <your_verified_sender@example.com>"
EMAIL_FROM_NAME=MessMate
EMAIL_FROM_ADDRESS=your_verified_sender@example.com
BREVO_API_KEY=your_brevo_api_key

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password

# One-time values used only by `npm run admin:bootstrap`.
BOOTSTRAP_ADMIN_NAME=Mess Admin
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PHONE=9876543210
BOOTSTRAP_ADMIN_PASSWORD=replace_with_a_temporary_strong_password
