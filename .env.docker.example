# Copy this file to .env.docker and replace every change-me value.
# Never use production credentials in the coursework environment.

MESSMATE_HTTP_PORT=8080
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001
GRAFANA_ADMIN_PASSWORD=replace-with-a-strong-local-password
MYSQL_USER=messmate_app
MYSQL_PASSWORD=change-me-local-database-password
MYSQL_ROOT_PASSWORD=change-me-local-root-password
JWT_SECRET=change-me-at-least-32-random-characters
